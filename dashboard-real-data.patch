@@ -0,0 +1,112 @@
+import { TestBed } from '@angular/core/testing';
+import { Subject, of, throwError } from 'rxjs';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { TipApi } from '../api/tip-api';
+import { DASHBOARD_APPLICATIONS_PAGE_SIZE, DashboardStore } from './dashboard-store';
+
+describe('DashboardStore', () => {
+  let api: {
+    listProfiles: ReturnType<typeof vi.fn>;
+    listApplications: ReturnType<typeof vi.fn>;
+    listMatchingReports: ReturnType<typeof vi.fn>;
+    listTailoringRequests: ReturnType<typeof vi.fn>;
+    listInterests: ReturnType<typeof vi.fn>;
+  };
+  let store: DashboardStore;
+
+  beforeEach(() => {
+    api = {
+      listProfiles: vi.fn(() => of([])),
+      listApplications: vi.fn(() => of({ items: [], page: 1, limit: 100, total: 0 })),
+      listMatchingReports: vi.fn(() => of([])),
+      listTailoringRequests: vi.fn(() => of([])),
+      listInterests: vi.fn(() => of({ items: [], page: 1, limit: 1, total: 7 })),
+    };
+    TestBed.configureTestingModule({ providers: [{ provide: TipApi, useValue: api }] });
+    store = TestBed.inject(DashboardStore);
+  });
+
+  it('starts idle with no data', () => {
+    expect(store.profile()).toEqual({ status: 'idle', data: null });
+    expect(store.applications().status).toBe('idle');
+  });
+
+  it('loads every widget from the API', () => {
+    store.load();
+
+    expect(store.profile()).toEqual({ status: 'loaded', data: { count: 0, defaultLabel: null, updatedAt: null } });
+    expect(store.interests()).toEqual({ status: 'loaded', data: 7 });
+    expect(store.reports().data).toEqual({ total: 0, latest: [] });
+    expect(store.tailoring().data).toEqual({ total: 0, latest: [] });
+    expect(store.applications().data?.total).toBe(0);
+  });
+
+  it('reads the application journal in one large page', () => {
+    store.load();
+
+    expect(api.listApplications).toHaveBeenCalledWith({ page: 1, limit: DASHBOARD_APPLICATIONS_PAGE_SIZE });
+    expect(api.listInterests).toHaveBeenCalledWith({ page: 1, limit: 1 });
+  });
+
+  it('keeps other widgets loaded when one request fails', () => {
+    api.listMatchingReports.mockReturnValue(throwError(() => new Error('boom')));
+
+    store.load();
+
+    expect(store.reports().status).toBe('error');
+    expect(store.profile().status).toBe('loaded');
+    expect(store.applications().status).toBe('loaded');
+    expect(store.interests().status).toBe('loaded');
+  });
+
+  it('keeps the last loaded data when a reload fails', () => {
+    store.load();
+    api.listInterests.mockReturnValue(throwError(() => new Error('boom')));
+
+    store.load();
+
+    expect(store.interests()).toEqual({ status: 'error', data: 7 });
+  });
+
+  it('shows loading while a request is pending', () => {
+    const pending = new Subject<never>();
+    api.listProfiles.mockReturnValue(pending);
+
+    store.load();
+
+    expect(store.profile().status).toBe('loading');
+  });
+
+  it('ignores responses that arrive after a reset', () => {
+    const pending = new Subject<unknown[]>();
+    api.listProfiles.mockReturnValue(pending);
+    store.load();
+
+    store.reset();
+    pending.next([]);
+
+    expect(store.profile()).toEqual({ status: 'idle', data: null });
+  });
+
+  it('ignores responses from a superseded load', () => {
+    const first = new Subject<unknown[]>();
+    api.listProfiles.mockReturnValueOnce(first).mockReturnValueOnce(
+      of([{ id: 'p', label: 'Current', output_language: 'en', is_default: true, created_at: '', updated_at: '' }]),
+    );
+
+    store.load();
+    store.load();
+    first.next([]);
+
+    expect(store.profile().data?.defaultLabel).toBe('Current');
+  });
+
+  it('clears all widgets on reset', () => {
+    store.load();
+
+    store.reset();
+
+    expect(store.interests()).toEqual({ status: 'idle', data: null });
+    expect(store.applications()).toEqual({ status: 'idle', data: null });
+  });
+});
diff --git a/src/app/core/state/dashboard-store.ts b/src/app/core/state/dashboard-store.ts
new file mode 100644
index 0000000..9239779
--- /dev/null
+++ b/src/app/core/state/dashboard-store.ts
@@ -0,0 +1,91 @@
+import { Injectable, WritableSignal, inject, signal } from '@angular/core';
+import { Observable, map } from 'rxjs';
+import { TipApi } from '../api/tip-api';
+import {
+  ApplicationsSummary,
+  ProfileSummary,
+  ReportsSummary,
+  TailoringSummary,
+  summarizeApplications,
+  summarizeProfiles,
+  summarizeReports,
+  summarizeTailoring,
+  toLocalIsoDate,
+} from './dashboard-summary';
+
+/** The journal is read in one page; the summary says when that page is not the whole list. */
+export const DASHBOARD_APPLICATIONS_PAGE_SIZE = 100;
+
+export interface WidgetState<T> {
+  status: 'idle' | 'loading' | 'loaded' | 'error';
+  /** Last successfully loaded value; kept while reloading or after a failed reload. */
+  data: T | null;
+}
+
+function idle<T>(): WidgetState<T> {
+  return { status: 'idle', data: null };
+}
+
+@Injectable({ providedIn: 'root' })
+export class DashboardStore {
+  private readonly api = inject(TipApi);
+  private generation = 0;
+
+  readonly profile = signal<WidgetState<ProfileSummary>>(idle());
+  readonly applications = signal<WidgetState<ApplicationsSummary>>(idle());
+  readonly reports = signal<WidgetState<ReportsSummary>>(idle());
+  readonly tailoring = signal<WidgetState<TailoringSummary>>(idle());
+  readonly interests = signal<WidgetState<number>>(idle());
+
+  /** Loads every widget independently; one failing request never blocks the others. */
+  load(): void {
+    const generation = ++this.generation;
+
+    this.run(this.profile, this.api.listProfiles().pipe(map(summarizeProfiles)), generation);
+    this.run(
+      this.applications,
+      this.api
+        .listApplications({ page: 1, limit: DASHBOARD_APPLICATIONS_PAGE_SIZE })
+        .pipe(map((page) => summarizeApplications(page.items, page.total, toLocalIsoDate(new Date())))),
+      generation,
+    );
+    this.run(this.reports, this.api.listMatchingReports().pipe(map((reports) => summarizeReports(reports))), generation);
+    this.run(
+      this.tailoring,
+      this.api.listTailoringRequests().pipe(map((requests) => summarizeTailoring(requests))),
+      generation,
+    );
+    this.run(
+      this.interests,
+      this.api.listInterests({ page: 1, limit: 1 }).pipe(map((page) => page.total)),
+      generation,
+    );
+  }
+
+  /** Drops all data and ignores any request still in flight (logout or user change). */
+  reset(): void {
+    this.generation++;
+    this.profile.set(idle());
+    this.applications.set(idle());
+    this.reports.set(idle());
+    this.tailoring.set(idle());
+    this.interests.set(idle());
+  }
+
+  private run<T>(target: WritableSignal<WidgetState<T>>, source: Observable<T>, generation: number): void {
+    target.update((state) => ({ ...state, status: 'loading' }));
+
+    source.subscribe({
+      next: (data) => {
+        if (generation === this.generation) {
+          target.set({ status: 'loaded', data });
+        }
+      },
+      error: () => {
+        if (generation === this.generation) {
+          target.update((state) => ({ ...state, status: 'error' }));
+        }
+      },
+    });
+  }
+}
