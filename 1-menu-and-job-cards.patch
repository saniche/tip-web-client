@@ -0,0 +1,43 @@
+<article class="job-card" [class.job-card--in-session]="inSession()" [attr.aria-labelledby]="'job-card-title-' + jobId()">
+  <header class="job-card__head">
+    <h2 class="job-card__title" [id]="'job-card-title-' + jobId()">
+      <a [routerLink]="['/normalized-jobs', jobId()]">{{ display(title()) }}</a>
+    </h2>
+    <p class="job-card__company">{{ display(company()) }}</p>
+    @if (inSession()) {
+      <span class="job-card__badge">In session</span>
+    }
+  </header>
+
+  <dl class="job-card__facts">
+    <div>
+      <dt>Location</dt>
+      <dd>{{ display(location()) }}</dd>
+    </div>
+    <div>
+      <dt>Posted</dt>
+      <dd>{{ date(postingDate()) }}</dd>
+    </div>
+    @if (extraLabel()) {
+      <div>
+        <dt>{{ extraLabel() }}</dt>
+        <dd>{{ date(extraValue()) }}</dd>
+      </div>
+    }
+  </dl>
+
+  <footer class="job-card__foot">
+    <span class="job-card__source">
+      @if (sourceLink(); as link) {
+        <a [href]="link.href" target="_blank" rel="noopener noreferrer">{{ link.label }}</a>
+      } @else if (sourceText(); as text) {
+        {{ text }}
+      } @else {
+        —
+      }
+    </span>
+    <div class="job-card__actions">
+      <ng-content />
+    </div>
+  </footer>
+</article>
diff --git a/src/app/shared/job-card/job-card.scss b/src/app/shared/job-card/job-card.scss
new file mode 100644
index 0000000..71c5322
--- /dev/null
+++ b/src/app/shared/job-card/job-card.scss
@@ -0,0 +1,107 @@
+:host {
+  display: block;
+  height: 100%;
+}
+
+.job-card {
+  display: flex;
+  flex-direction: column;
+  gap: 0.85rem;
+  height: 100%;
+  padding: 1rem 1.1rem;
+  background: var(--tip-surface);
+  border: 1px solid var(--tip-border);
+  border-radius: 0.75rem;
+
+  &:hover,
+  &:focus-within {
+    border-color: var(--tip-blue);
+  }
+
+  // The left edge only appears when the job is part of the matching session.
+  &--in-session {
+    box-shadow: inset 0.25rem 0 0 var(--tip-coral);
+  }
+
+  &__head {
+    display: grid;
+    gap: 0.15rem;
+  }
+
+  &__title {
+    margin: 0;
+    font-size: 1.05rem;
+    font-weight: 700;
+    line-height: 1.3;
+    overflow-wrap: anywhere;
+
+    a {
+      color: var(--tip-navy);
+      text-decoration: none;
+
+      &:hover {
+        text-decoration: underline;
+      }
+    }
+  }
+
+  &__company {
+    margin: 0;
+    color: var(--tip-muted);
+  }
+
+  &__badge {
+    justify-self: start;
+    margin-top: 0.35rem;
+    padding: 0.1rem 0.5rem;
+    border-radius: 999px;
+    background: #fdeee9;
+    color: #9b3f27;
+    font-size: 0.8rem;
+    font-weight: 600;
+  }
+
+  &__facts {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
+    gap: 0.5rem 1rem;
+    margin: 0;
+
+    dt {
+      color: var(--tip-muted);
+      font-size: 0.8rem;
+      font-weight: 400;
+    }
+
+    dd {
+      margin: 0;
+      overflow-wrap: anywhere;
+    }
+  }
+
+  &__foot {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: space-between;
+    gap: 0.5rem 0.75rem;
+    margin-top: auto;
+    padding-top: 0.75rem;
+    border-top: 1px solid var(--tip-border);
+  }
+
+  &__source {
+    min-width: 0;
+    color: var(--tip-muted);
+    font-size: 0.9rem;
+    overflow-wrap: anywhere;
+  }
+
+  &__actions {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: flex-end;
+    gap: 0.35rem;
+  }
+}
